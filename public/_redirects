/_next/*    /_next/:splat       200

# API routes - let Cloudflare Functions handle them
/api/*      /api/:splat         200

# Admin routes with client-side routing
# Serve the admin SPA root (avoid pointing to an explicit index file to prevent loop)
/admin/*    /admin/   200

# Static assets - ensure they're served directly
/logos/*    /logos/:splat     200
/assets/*    /assets/:splat     200
