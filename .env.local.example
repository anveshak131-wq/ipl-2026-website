# Copy to .env.local for Next.js local dev (gitignored).
# For Cloudflare Functions local dev, use .dev.vars instead (see .dev.vars.example).

# OpenWeather (used by Pages Functions: /api/weather, cron weather-update)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Optional: WeatherAPI.com (only if using weather-forecast / weather-scheduler)
# WEATHER_API_KEY=your_weatherapi_com_key_here

# Optional: OpenCage Geocoding API (for better venue search)
# OPENCAGE_API_KEY=your_opencage_api_key_here

# Optional: OpenAI API (for AI-powered venue information)
# OPENAI_API_KEY=your_openai_api_key_here

NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000
